model Task {
  id        Int      @id @default(autoincrement())
  title     String
  status    String   @default("pending")
  lat       Float?
  lng       Float?
  createdAt TimestamptzString @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
}